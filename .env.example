# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local a GitHub.

# Supabase (Settings → API). Solo la clave pública "anon"; NUNCA la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# (ya hay valores por defecto en src/lib/supabase/config.ts; estas variables los sustituyen)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API (console.anthropic.com → API Keys). Solo se usa en el servidor.
ANTHROPIC_API_KEY=
